APP_ENV=development
PRODUCT_DATA_PATH=./data/products.json
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=50
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
VECTOR_COLLECTION_NAME=shopsmart-products
VECTOR_DB_PATH=./storage/chroma
INGESTION_MAX_RETRIES=3
INGESTION_LOG_LEVEL=INFO

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1200
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
